# ==============================================================================
# Auto Viral Cuts - Environment Variables
# ==============================================================================

# Google Gemini API Key (Obtenha em https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Obtenha em https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here


# Modelo padrão do Gemini
GEMINI_MODEL=gemini-3.6-flash

# Modelo usado automaticamente se o principal estiver temporariamente indisponível
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Configurações do Servidor FastAPI + Gradio
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# Configurações de Armazenamento
OUTPUT_DIR=output_cuts
TEMP_DIR=temp_uploads

# Aceleração por Hardware / GPU (auto, vaapi, nvenc, videotoolbox, cpu)
HW_ACCEL=auto
VAAPI_DEVICE=/dev/dri/renderD128
